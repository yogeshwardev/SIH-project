# ==========================================
# CraftLink AI - Environment Configuration
# ==========================================

# Project Settings
PROJECT_NAME="CraftLink AI"
API_PREFIX="/api"

# AI Provider Configuration
# Options: "local" (default built-in zero-dependency AI engine), "gemini", "openai", "groq"
AI_PROVIDER=local

# Optional external LLM API Keys (if using cloud AI)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
GROQ_API_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=8000
